import { Theme } from "theme.slint";

export component Card inherits Rectangle {
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
}

export component Label inherits Text {
    color: Theme.text;
    font-size: 14px;
    wrap: word-wrap;
}
export component Muted inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}
export component H1 inherits Text {
    color: Theme.text;
    font-size: 22px;
    font-weight: 700;
    wrap: word-wrap;
}
export component H2 inherits Text {
    color: Theme.text;
    font-size: 16px;
    font-weight: 600;
    wrap: word-wrap;
}

// Initials in a coloured circle (no network images needed).
export component Avatar inherits Rectangle {
    in property <string> name;
    in property <length> size: 36px;
    in property <bool> online;
    width: size;
    height: size;
    border-radius: size / 2;
    background: Theme.accent.mix(#22d3ee, 0.6);
    Text {
        text: name.character-count > 0 ? name.to-uppercase() : "?";
        color: white;
        font-size: root.size * 0.42;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
        overflow: clip;
    }
    if online: Rectangle {
        x: parent.width - 11px;
        y: parent.height - 11px;
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        background: Theme.good;
        border-width: 2px;
        border-color: Theme.panel;
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.accent;
    height: 20px;
    width: max(20px, t.preferred-width + 12px);
    border-radius: 10px;
    background: tone;
    t := Text {
        text: root.text;
        color: white;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A pill-shaped status tag.
export component Tag inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.muted;
    height: 22px;
    width: t.preferred-width + 16px;
    border-radius: 11px;
    background: tone.transparentize(0.82);
    t := Text {
        text: root.text;
        color: root.tone;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> active;
    in property <int> badge;
    in property <bool> compact;
    callback clicked;
    height: compact ? 54px : 40px;
    border-radius: 10px;
    background: active ? Theme.accent.transparentize(0.75) : ta.has-hover ? Theme.panel2 : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    if !compact: HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        Text { text: root.glyph; font-size: 16px; color: active ? Theme.accent : Theme.muted; vertical-alignment: center; width: 20px; }
        Text { text: root.label; font-size: 14px; color: active ? Theme.text : Theme.muted; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if root.badge > 0: Badge { text: root.badge > 99 ? "99+" : root.badge; y: (parent.height - self.height) / 2; }
    }
    if compact: VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text { text: root.glyph; font-size: 18px; color: active ? Theme.accent : Theme.muted; horizontal-alignment: center; }
        Text { text: root.label; font-size: 10px; color: active ? Theme.text : Theme.muted; horizontal-alignment: center; overflow: elide; }
    }
    if compact && root.badge > 0: Rectangle {
        x: parent.width / 2 + 6px;
        y: 4px;
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        background: Theme.bad;
    }
}

// Coloured notice line (errors, hints).
export component Notice inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.warn;
    visible: text != "";
    height: text == "" ? 0px : t.preferred-height;
    border-radius: 8px;
    background: tone.transparentize(0.85);
    t := Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        color: root.tone.mix(Theme.text, 0.55);
        font-size: 13px;
        wrap: word-wrap;
        vertical-alignment: center;
        height: parent.height;
    }
}

export component Stat inherits Card {
    in property <string> label;
    in property <string> value;
    in property <string> glyph;
    min-height: 74px;
    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        Text { text: root.glyph; font-size: 26px; vertical-alignment: center; width: 36px; }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Muted { text: root.label; }
            Text { text: root.value; color: Theme.text; font-size: 20px; font-weight: 700; overflow: elide; }
        }
    }
}
